# Copy to .env (repo root — read by docker compose for ${...} interpolation).
# NEVER commit real secrets; .env is gitignored.

# Shared secret between the Nginx ACV Proxy and the backend (mTLS deployments).
# Both containers receive the same value; requests without it are rejected.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PROXY_SECRET=

# JWT signing key for the backend (compose refuses to start without it).
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# --- PostgreSQL (the `db` compose service) -----------------------------------
# Credentials for the Postgres container. Dev-only defaults live in the compose
# file; set real values here for anything shared or deployed. NEVER commit them.
POSTGRES_USER=acvp
POSTGRES_PASSWORD=acvp-dev-only
POSTGRES_DB=acvp
# Optional: override the full URL the backend uses (default targets the `db`
# service). Must match the POSTGRES_* values above.
# DATABASE_URL=postgresql+psycopg://acvp:acvp-dev-only@db:5432/acvp
